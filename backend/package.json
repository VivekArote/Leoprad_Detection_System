{
  "name": "leoparddetection",
  "version": "2.0.0",
  "type": "module",
  "description": "Production-grade Leopard Detection System with MongoDB, Cloudinary, Analytics Dashboard",
  "main": "main.js",
  "scripts": {
    "start": "node main.js",
    "dev": "nodemon main.js",
    "test": "node --experimental-vm-modules ./node_modules/jest-cli/bin/jest.js --forceExit --detectOpenHandles",
    "test:coverage": "node --experimental-vm-modules ./node_modules/jest-cli/bin/jest.js --coverage --forceExit --detectOpenHandles",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest-cli/bin/jest.js --watch"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/public/**"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 80
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VIVEKAROTE/leopard-detection-system.git"
  },
  "author": "vivek arote",
  "license": "ISC",
  "dependencies": {
    "cloudinary": "^2.6.1",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "mongoose": "^8.15.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.2",
    "serialport": "^13.0.0",
    "telegraf": "^4.16.3",
    "uuid": "^11.1.0",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.1.0"
  }
}
